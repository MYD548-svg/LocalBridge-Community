{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LocalBridge",
  "version": "0.1.5",
  "identifier": "com.localbridge.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build && node scripts/prepare-lb018-resources.mjs",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../tests/artifacts/frontend-dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost data:; font-src 'self'; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "../assets/icons/localbridge.ico"
    ],
    "externalBin": [],
    "resources": {
      "../runtime/python/": "runtime/python/",
      "../runtime/coding-tools-mcp/": "runtime/coding-tools-mcp/",
      "../runtime/tunnel-client/": "runtime/tunnel-client/",
      "target/toolbox-stage/": "runtime/toolbox/",
      "target/release-stage/localbridge-privileged-broker.exe": "localbridge-privileged-broker.exe",
      "../runtime-manifest.toml": "runtime-manifest.toml",
      "../runtime-policy.toml": "runtime-policy.toml",
      "../LICENSE": "LICENSE",
      "../THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md",
      "target/local-mcp-stage/localbridge-mcp.exe": "localbridge-mcp.exe",
      "target/browser-host-stage/localbridge-browser-host.exe": "localbridge-browser-host.exe",
      "target/browser-host-stage/native-host-template.json": "native-host-template.json",
      "target/browser-extension-stage/extension.zip": "browser-extension/extension.zip",
      "target/browser-extension-stage/bundle.json": "browser-extension/bundle.json",
      "../docs/licenses/mcp-proxy-MIT.txt": "licenses/mcp-proxy-MIT.txt"
    },
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "installerHooks": "../scripts/public-release/nsis-hooks.nsh"
      }
    }
  }
}
